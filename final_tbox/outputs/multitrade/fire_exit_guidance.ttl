@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tbox: <https://example.org/kicem/fire/exit-guidance#> .

<https://example.org/kicem/fire/exit-guidance> a owl:Ontology ;
    owl:versionInfo "3.1.0" .

tbox:AuditoriumGuidanceLightInstallation a owl:Class ;
    rdfs:label "객석유도등 설치"@ko ;
    rdfs:comment "객석의 통로·바닥 또는 벽에 유도등을 설치하는 작업."@ko ;
    rdfs:subClassOf tbox:ExitGuidanceEquipmentWork,
        tbox:InstallationTask ;
    tbox:evidenceSection "2.4" ;
    tbox:evidenceSourceId "NFTC-303" ;
    tbox:predictedDirectParent tbox:InstallationTask ;
    tbox:predictionMethod "lexical-taxonomic-v1:upper-tbox-lifecycle" ;
    tbox:validationStatus "candidate" .

tbox:CorridorGuidanceLightInstallation a owl:Class ;
    rdfs:label "복도통로유도등 설치"@ko ;
