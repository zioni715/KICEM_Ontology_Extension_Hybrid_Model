    <rdfs:comment>공종별 상세 비용을 합산해 제시하는 근거서류</rdfs:comment>
    <tbox:origin>seed</tbox:origin>
    <rdfs:subClassOf rdf:resource="https://example.org/kicem/hybrid/civil_stormwater#EvidenceDocument"/>
