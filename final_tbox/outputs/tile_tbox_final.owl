    <rdfs:comment xml:lang="ko">기성서류가 포함하는 비용정보 항목</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ProgressDocument" />
    <rdfs:label xml:lang="ko">항목 포함</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#DocumentItem" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#contractAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">계약내역서에 확정된 금액</rdfs:comment>
    <rdfs:label xml:lang="ko">계약금액</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#contractQuantity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">계약내역서에 확정된 수량</rdfs:comment>
    <rdfs:label xml:lang="ko">계약수량</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#contractUnitPrice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">계약내역서에 확정된 단가</rdfs:comment>
    <rdfs:label xml:lang="ko">계약단가</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#contributesContractAmountTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">공종별내역항목의 계약금액을 계약집계항목으로 합산</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#WorkCategoryDetailItem" />
    <rdfs:label xml:lang="ko">계약금액 → 공종별 계약집계</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#ContractSummaryItem" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#contributesCurrentAmountTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">기성내역항목의 금회금액을 기성집계항목으로 합산</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ProgressPaymentItem" />
    <rdfs:label xml:lang="ko">금회금액 → 공종별 기성집계</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#ProgressPaymentSummaryItem" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#cumulativeAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">전회누계금액과 금회금액의 합</rdfs:comment>
    <rdfs:label xml:lang="ko">누계금액</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#cumulativeQuantity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">전회누계수량과 금회수량의 합</rdfs:comment>
    <rdfs:label xml:lang="ko">누계수량</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#currentAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">현재 기성회차에서 인정되며 누계기성금액 산정에 반영되는 금액</rdfs:comment>
    <rdfs:label xml:lang="ko">금회금액</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#currentQuantity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">기성내역 한 행에서 현재 회차에 인정된 수량</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ProgressPaymentItem" />
    <rdfs:label xml:lang="ko">금회수량</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#documentIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">업무에서 서류를 식별하는 문자열</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ProgressDocument" />
    <rdfs:label xml:lang="ko">서류 식별자</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#evidenceSourceId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty" />
    <rdfs:label xml:lang="ko">근거 출처 식별자</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#expenseUnitCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">비용항목 한 단위당 경비</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#CostCalculationItem" />
    <rdfs:label xml:lang="ko">단위당 경비</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#itemCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">비용항목의 식별 코드</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#CostItem" />
    <rdfs:label xml:lang="ko">항목 코드</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#itemName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">서류항목과 비용항목에서 공통으로 사용하는 품명</rdfs:comment>
    <rdfs:label xml:lang="ko">항목명</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#laborUnitCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">비용항목 한 단위당 노무비</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#CostCalculationItem" />
    <rdfs:label xml:lang="ko">단위당 노무비</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#materialUnitCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">비용항목 한 단위당 재료비</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#CostCalculationItem" />
    <rdfs:label xml:lang="ko">단위당 재료비</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#partOfWorkTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">세부 작업이 상위 작업에 포함되는 관계.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#WorkTask" />
    <rdfs:label xml:lang="ko">작업 구성 관계</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#WorkTask" />
    <tile:researchOrigin>researcher_relation_adapter</tile:researchOrigin>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#previousCumulativeAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">직전 회차까지 인정된 누계금액</rdfs:comment>
    <rdfs:label xml:lang="ko">전회누계금액</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#previousCumulativeQuantity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">직전 회차까지 인정된 누계수량</rdfs:comment>
    <rdfs:label xml:lang="ko">전회누계수량</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#previousProgressRound">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">현재 회차가 이월값을 참조하는 직전 회차</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ProgressPaymentRound" />
    <rdfs:label xml:lang="ko">이전 기성회차</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#ProgressPaymentRound" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#providesCalculatedQuantityTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">수량산출항목의 calculatedQuantity를 계약항목의 contractQuantity 근거로 전달</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#CalculatedQuantityItem" />
    <rdfs:label xml:lang="ko">산출수량 → 계약수량</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#ContractItem" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#providesContractAmountTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">계약항목의 contractAmount를 공종별내역항목의 contractAmount로 전달</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ContractItem" />
    <rdfs:label xml:lang="ko">계약금액 → 공종별내역 계약금액</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#WorkCategoryDetailItem" />
    <rdfs:subPropertyOf rdf:resource="https://example.org/kicem/tile/final#providesContractValueTo" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#providesContractAmountToProgressPaymentItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">계약항목의 contractAmount를 기성내역항목의 contractAmount로 전달</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ContractItem" />
    <rdfs:label xml:lang="ko">계약금액 → 기성내역 계약금액</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#ProgressPaymentItem" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#providesContractQuantityTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">계약항목의 contractQuantity를 공종별내역항목의 contractQuantity로 전달</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ContractItem" />
    <rdfs:label xml:lang="ko">계약수량 → 공종별내역 계약수량</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#WorkCategoryDetailItem" />
    <rdfs:subPropertyOf rdf:resource="https://example.org/kicem/tile/final#providesContractValueTo" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#providesContractQuantityToProgressPaymentItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">계약항목의 contractQuantity를 기성내역항목의 contractQuantity로 전달</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ContractItem" />
    <rdfs:label xml:lang="ko">계약수량 → 기성내역 계약수량</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#ProgressPaymentItem" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#providesContractUnitPriceTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">계약항목의 contractUnitPrice를 공종별내역항목의 contractUnitPrice로 전달</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ContractItem" />
    <rdfs:label xml:lang="ko">계약단가 → 공종별내역 계약단가</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#WorkCategoryDetailItem" />
    <rdfs:subPropertyOf rdf:resource="https://example.org/kicem/tile/final#providesContractValueTo" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#providesContractUnitPriceToProgressPaymentItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">계약항목의 contractUnitPrice를 기성내역항목의 contractUnitPrice로 전달</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ContractItem" />
    <rdfs:label xml:lang="ko">계약단가 → 기성내역 계약단가</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#ProgressPaymentItem" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#providesContractValueTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">계약항목의 수량·단가·금액을 공종별내역항목으로 전달</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ContractItem" />
    <rdfs:label xml:lang="ko">계약값 전달</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#WorkCategoryDetailItem" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#providesCumulativeValuesTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty" />
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">이전 기성내역항목의 누계수량·누계금액을 현재 기성내역항목의 전회누계값으로 전달</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ProgressPaymentItem" />
    <rdfs:label xml:lang="ko">이전 누계 → 현재 전회값</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#ProgressPaymentItem" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#releaseCuration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty" />
    <rdfs:label xml:lang="ko">최종본 교정 내역</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#remainingAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">계약금액에서 누계금액을 뺀 값</rdfs:comment>
    <rdfs:label xml:lang="ko">잔여금액</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#remainingQuantity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">계약수량에서 누계수량을 뺀 값</rdfs:comment>
    <rdfs:label xml:lang="ko">잔여수량</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#representsCostItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">서류항목이 의미하는 표준 비용항목</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#DocumentItem" />
    <rdfs:label xml:lang="ko">비용항목 표현</rdfs:label>
    <rdfs:range rdf:resource="https://example.org/kicem/tile/final#CostItem" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#researchOrigin">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty" />
    <rdfs:label xml:lang="ko">생성 출처</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#roundNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">기성회차의 순번</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#ProgressPaymentRound" />
    <rdfs:label xml:lang="ko">회차 번호</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#specification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty" />
    <rdfs:comment xml:lang="ko">공종 다음에 비용항목을 구분하는 규격 문자열</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#CostItem" />
    <rdfs:label xml:lang="ko">규격</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string" />
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/tile/final#subWorkCategoryOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty" />
    <rdfs:comment xml:lang="ko">세부 공종이 속하는 상위 공종</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/kicem/tile/final#WorkCategory" />
