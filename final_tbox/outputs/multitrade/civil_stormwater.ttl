@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tbox: <https://example.org/kicem/civil/stormwater#> .

<https://example.org/kicem/civil/stormwater> a owl:Ontology .

tbox:CatchBasinInstallation a owl:Class ;
    rdfs:label "집수정 설치"@ko ;
    rdfs:comment "집수정을 계획 위치와 높이에 설치하는 작업."@ko ;
    rdfs:subClassOf tbox:InstallationTask,
        tbox:StormwaterWork ;
    tbox:evidenceSection "3.1.3" ;
    tbox:evidenceSourceId "KCS-11-40-25" ;
    tbox:predictedDirectParent tbox:InstallationTask ;
    tbox:validationStatus "candidate" .

tbox:DrainageDitchConstruction a owl:Class ;
    rdfs:label "배수 측구 시공"@ko ;
    rdfs:comment "설계 선형과 경사에 따라 측구를 시공하는 작업."@ko ;
    rdfs:subClassOf tbox:InstallationTask,
        tbox:StormwaterWork ;
    tbox:evidenceSection "3.1.1" ;
    tbox:evidenceSourceId "KCS-11-40-25" ;
    tbox:predictedDirectParent tbox:InstallationTask ;
    tbox:validationStatus "candidate" .

tbox:DrainageSlopeControl a owl:Class ;
    rdfs:label "배수 경사 관리"@ko ;
    rdfs:comment "측구와 관로의 계획 경사가 유지되는지 확인하는 검사."@ko ;
    rdfs:subClassOf tbox:InspectionTask,
        tbox:StormwaterWork ;
    tbox:evidenceSection "3.1.1(9)" ;
    tbox:evidenceSourceId "KCS-11-40-25" ;
    tbox:predictedDirectParent tbox:InspectionTask ;
    tbox:validationStatus "candidate" .

tbox:DrainageWatertightJointConstruction a owl:Class ;
    rdfs:label "배수관 접합부 수밀 시공"@ko ;
    rdfs:comment "배수관 접합부를 수밀하게 마감하는 작업."@ko ;
    rdfs:subClassOf tbox:InstallationTask,
        tbox:StormwaterWork ;
    tbox:evidenceSection "3.1.1" ;
    tbox:evidenceSourceId "KCS-11-40-25" ;
    tbox:predictedDirectParent tbox:InstallationTask ;
    tbox:validationStatus "candidate" .

tbox:SteelGratingInstallation a owl:Class ;
    rdfs:label "스틸그레이팅 설치"@ko ;
    rdfs:comment "우수받이 또는 집수정에 스틸그레이팅을 설치하는 작업."@ko ;
    rdfs:subClassOf tbox:InstallationTask,
        tbox:StormwaterWork ;
    tbox:evidenceSection "3.1.3(3)③" ;
    tbox:evidenceSourceId "KCS-11-40-25" ;
    tbox:predictedDirectParent tbox:InstallationTask ;
    tbox:validationStatus "candidate" .

tbox:StormDrainPipeInstallation a owl:Class ;
    rdfs:label "우수 배수관 설치"@ko ;
    rdfs:comment "계획 경사를 유지하여 우수 배수관을 설치하는 작업."@ko ;
    rdfs:subClassOf tbox:InstallationTask,
        tbox:StormwaterWork ;
    tbox:evidenceSection "3.1.1(9)" ;
    tbox:evidenceSourceId "KCS-11-40-25" ;
    tbox:predictedDirectParent tbox:InstallationTask ;
    tbox:validationStatus "candidate" .

tbox:StormwaterBackfillingCompaction a owl:Class ;
    rdfs:label "우수 구조물 되메우기 및 다짐"@ko ;
    rdfs:comment "우수 구조물 주위를 되메우고 다지는 작업."@ko ;
    rdfs:subClassOf tbox:FinishingTask,
        tbox:StormwaterWork ;
    tbox:evidenceSection "3.1.3(3)④" ;
    tbox:evidenceSourceId "KCS-11-40-25" ;
    tbox:predictedDirectParent tbox:FinishingTask ;
    tbox:validationStatus "candidate" .

tbox:StormwaterInletInstallation a owl:Class ;
    rdfs:label "우수받이 설치"@ko ;
    rdfs:comment "우수받이를 계획 위치와 높이에 설치하는 작업."@ko ;
    rdfs:subClassOf tbox:InstallationTask,
        tbox:StormwaterWork ;
    tbox:evidenceSection "3.1.3" ;
    tbox:evidenceSourceId "KCS-11-40-25" ;
    tbox:predictedDirectParent tbox:InstallationTask ;
    tbox:validationStatus "candidate" .

tbox:StormwaterInstallationInspection a owl:Class ;
    rdfs:label "우수시설 설치 검사"@ko ;
    rdfs:comment "기초면·철근·매설물과 설치 상태를 확인하는 검사."@ko ;
    rdfs:subClassOf tbox:InspectionTask,
        tbox:StormwaterWork ;
    tbox:evidenceSection "3.1.3(1)" ;
    tbox:evidenceSourceId "KCS-11-40-25" ;
    tbox:predictedDirectParent tbox:InspectionTask ;
    tbox:validationStatus "candidate" .

tbox:StormwaterManholeInstallation a owl:Class ;
    rdfs:label "우수 맨홀 설치"@ko ;
    rdfs:comment "우수관로 점검을 위한 맨홀과 뚜껑을 설치하는 작업."@ko ;
    rdfs:subClassOf tbox:InstallationTask,
        tbox:StormwaterWork ;
    tbox:evidenceSection "2.5, 3.1" ;
    tbox:evidenceSourceId "KCS-11-40-25" ;
    tbox:predictedDirectParent tbox:InstallationTask ;
    tbox:validationStatus "candidate" .

tbox:StormwaterPipelineSurvey a owl:Class ;
    rdfs:label "우수관로 중심선 및 수준 측량"@ko ;
    rdfs:comment "우수관로의 위치와 계획고를 확인하는 측량 작업."@ko ;
    rdfs:subClassOf tbox:PreparationTask,
        tbox:StormwaterWork ;
    tbox:evidenceSection "3.2.2(1)" ;
    tbox:evidenceSourceId "KCS-12-20-10" ;
    tbox:predictedDirectParent tbox:PreparationTask ;
    tbox:validationStatus "candidate" .

tbox:evidenceSection a owl:AnnotationProperty ;
    rdfs:label "근거 조항"@ko .

tbox:evidenceSourceId a owl:AnnotationProperty ;
    rdfs:label "근거 출처 식별자"@ko .

tbox:predictedDirectParent a owl:AnnotationProperty ;
    rdfs:label "모델 예측 직접 부모"@ko .

tbox:validationStatus a owl:AnnotationProperty ;
    rdfs:label "검증 상태"@ko .

tbox:ConstructionTask a owl:Class ;
    rdfs:label "공종 작업"@ko ;
    rdfs:comment "특정 공종을 구성하는 작업 유형."@ko ;
    rdfs:subClassOf tbox:WorkTask ;
    tbox:evidenceSection "common upper T-Box" ;
    tbox:evidenceSourceId "SYSTEM-SCHEMA" ;
    tbox:validationStatus "candidate" .

tbox:FinishingTask a owl:Class ;
    rdfs:label "마무리 작업"@ko ;
    rdfs:comment "본 시공 이후 수행되는 마무리 작업 유형."@ko ;
    rdfs:subClassOf tbox:WorkTask ;
    tbox:evidenceSection "common upper T-Box" ;
    tbox:evidenceSourceId "SYSTEM-SCHEMA" ;
    tbox:validationStatus "candidate" .

tbox:PreparationTask a owl:Class ;
    rdfs:label "준비 작업"@ko ;
    rdfs:comment "본 시공 전에 수행되는 준비 작업 유형."@ko ;
    rdfs:subClassOf tbox:WorkTask ;
    tbox:evidenceSection "common upper T-Box" ;
    tbox:evidenceSourceId "SYSTEM-SCHEMA" ;
    tbox:validationStatus "candidate" .

tbox:InspectionTask a owl:Class ;
    rdfs:label "검사 작업"@ko ;
    rdfs:comment "시공 상태나 성능을 확인하는 작업 유형."@ko ;
    rdfs:subClassOf tbox:WorkTask ;
    tbox:evidenceSection "common upper T-Box" ;
    tbox:evidenceSourceId "SYSTEM-SCHEMA" ;
    tbox:validationStatus "candidate" .

tbox:WorkTask a owl:Class ;
    rdfs:label "건설 작업"@ko ;
    rdfs:comment "건설 과정에서 수행되는 작업 유형."@ko ;
    tbox:evidenceSection "common upper T-Box" ;
    tbox:evidenceSourceId "SYSTEM-SCHEMA" ;
    tbox:validationStatus "candidate" .

tbox:StormwaterWork a owl:Class ;
    rdfs:label "우수공"@ko ;
    rdfs:comment "우수를 집수하고 배제하는 토목 작업 유형."@ko ;
    rdfs:subClassOf tbox:ConstructionTask ;
    tbox:evidenceSection "KCS 11 40 25" ;
    tbox:evidenceSourceId "KCS-11-40-25" ;
    tbox:predictedDirectParent tbox:ConstructionTask ;
    tbox:validationStatus "candidate" .

tbox:InstallationTask a owl:Class ;
    rdfs:label "설치 작업"@ko ;
    rdfs:comment "시설 또는 마감재를 설치하는 작업 유형."@ko ;
    rdfs:subClassOf tbox:WorkTask ;
    tbox:evidenceSection "common upper T-Box" ;
    tbox:evidenceSourceId "SYSTEM-SCHEMA" ;
    tbox:validationStatus "candidate" .
