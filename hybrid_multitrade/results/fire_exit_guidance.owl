    <rdfs:subClassOf rdf:resource="https://example.org/kicem/hybrid/fire_exit_guidance#DetailItem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/hybrid/fire_exit_guidance#EvidenceDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>근거서류</rdfs:label>
    <rdfs:comment>기성금액 산정에 필요한 수량·단가·금액의 근거를 제공하는 서류</rdfs:comment>
    <tbox:origin>seed</tbox:origin>
    <rdfs:subClassOf rdf:resource="https://example.org/kicem/hybrid/fire_exit_guidance#ProgressDocument"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/hybrid/fire_exit_guidance#DetailItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>상세비용항목</rdfs:label>
