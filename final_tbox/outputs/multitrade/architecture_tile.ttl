tbox:evidenceSection a owl:AnnotationProperty ;
    rdfs:label "근거 조항"@ko .

tbox:evidenceSourceId a owl:AnnotationProperty ;
    rdfs:label "근거 출처 식별자"@ko .

tbox:predictedDirectParent a owl:AnnotationProperty ;
    rdfs:label "모델 예측 직접 부모"@ko .

tbox:predictionMethod a owl:AnnotationProperty ;
    rdfs:label "부모 예측 방법"@ko .

tbox:validationStatus a owl:AnnotationProperty ;
    rdfs:label "검증 상태"@ko .

tbox:ConstructionTask a owl:Class ;
