@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tile: <https://example.org/kicem/tile/final#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:source a owl:AnnotationProperty ;
    rdfs:label "출처"@ko .

<https://example.org/kicem/tile/final> a owl:Ontology .

tile:CeramicTileCostItem a owl:Class ;
    rdfs:label "세라믹타일 비용항목"@ko ;
    rdfs:comment "세라믹타일의 비용을 나타내는 항목으로, 바닥 및 벽에 사용되는 세라믹타일의 가격을 포함한다."@ko ;
    rdfs:subClassOf tile:TileMaterialCostItem ;
    tile:evidenceSourceId "건내:389",
        "건내:390",
        "건내:391" ;
    tile:researchOrigin "LLM_document_proposal" ;
    tile:validationStatus "provisional" .

tile:CeramicTilePressureBondingCostItem a owl:Class ;
    rdfs:label "세라믹타일 압착붙임 비용"@ko ;
    rdfs:comment "세라믹타일 압착붙임 작업의 비용대상."@ko ;
    rdfs:subClassOf tile:TileInstallationCostItem ;
    tile:evidenceSourceId "건내:398",
        "건내:399",
        "건내:400" ;
    tile:releaseCuration "identifier normalised from CeramicTileAdhesiveCostItem" ;
    tile:researchOrigin "LLM_document_proposal" ;
    tile:validationStatus "provisional" .

tile:MosaicTileCostItem a owl:Class ;
    rdfs:label "모자이크타일 비용항목"@ko ;
    rdfs:comment "모자이크타일의 비용을 나타내는 항목으로, 벽면에 사용되는 모자이크타일의 가격을 포함한다."@ko ;
    rdfs:subClassOf tile:TileMaterialCostItem ;
    tile:evidenceSourceId "건내:414",
        "건내:415" ;
    tile:researchOrigin "LLM_document_proposal" ;
    tile:validationStatus "provisional" .

tile:MosaicTilePressureBondingCostItem a owl:Class ;
    rdfs:label "모자이크타일 압착붙임 비용"@ko ;
    rdfs:comment "모자이크타일 압착붙임 작업의 비용대상."@ko ;
    rdfs:subClassOf tile:TileInstallationCostItem ;
    tile:evidenceSourceId "건내:416" ;
    tile:releaseCuration "identifier normalised from MosaicTileAdhesiveCostItem" ;
    tile:researchOrigin "LLM_document_proposal" ;
    tile:validationStatus "provisional" .

tile:NonSlipTileCostItem a owl:Class ;
    rdfs:label "논슬립타일 비용항목"@ko ;
    rdfs:comment "논슬립타일의 비용을 나타내는 항목으로, 주로 화장실 및 샤워실에 사용되는 논슬립타일의 가격을 포함한다."@ko ;
    rdfs:subClassOf tile:TileMaterialCostItem ;
    tile:evidenceSourceId "건내:403",
        "건내:404",
        "건내:405" ;
    tile:researchOrigin "LLM_document_proposal" ;
    tile:validationStatus "provisional" .

tile:PorcelainTileCostItem a owl:Class ;
    rdfs:label "포세린타일 비용항목"@ko ;
    rdfs:comment "포세린타일의 비용을 나타내는 항목으로, 주로 화장실 및 바닥에 사용되는 포세린타일의 가격을 포함한다."@ko ;
    rdfs:subClassOf tile:TileMaterialCostItem ;
    tile:evidenceSourceId "건내:387",
        "건내:421" ;
    tile:researchOrigin "LLM_document_proposal" ;
    tile:validationStatus "provisional" .

tile:PorcelainTilePressureBondingCostItem a owl:Class ;
    rdfs:label "포세린타일 압착붙임 비용"@ko ;
    rdfs:comment "포세린타일 압착붙임 작업의 비용대상."@ko ;
    rdfs:subClassOf tile:TileInstallationCostItem ;
    tile:evidenceSourceId "건내:388" ;
    tile:releaseCuration "identifier normalised from PorcelainTileAdhesiveCostItem" ;
    tile:researchOrigin "LLM_document_proposal" ;
    tile:validationStatus "provisional" .

tile:StoneTilePressureBondingCostItem a owl:Class ;
    rdfs:label "석재타일 압착붙임 비용"@ko ;
    rdfs:comment "석재타일 압착붙임 작업의 비용대상."@ko ;
    rdfs:subClassOf tile:TileInstallationCostItem ;
    tile:evidenceSourceId "건내:386" ;
    tile:releaseCuration "identifier normalised from StoneTileAdhesiveCostItem" ;
    tile:researchOrigin "LLM_document_proposal" ;
    tile:validationStatus "provisional" .

tile:TileInspection a owl:Class ;
    rdfs:label "타일 검사"@ko ;
    rdfs:comment "타일 시공 후 품질을 확인하기 위한 검사 작업으로, 시공 중 검사 및 접착력 시험 등을 포함합니다."@ko ;
    rdfs:subClassOf tile:WorkTask ;
    tile:evidenceSourceId "WBS:3.6" ;
    tile:researchOrigin "LLM_WBS_proposal" ;
    tile:validationStatus "provisional" .

tile:WallTileInstallation a owl:Class ;
    rdfs:label "벽 타일 시공"@ko ;
    rdfs:comment "벽면에 타일을 설치하는 작업 활동."@ko ;
    rdfs:subClassOf tile:TileInstallation ;
    tile:evidenceSourceId "WBS:3.2.1",
        "WBS:3.2.4",
        "WBS:3.2.6",
        "WBS:3.2.7" ;
    tile:releaseCuration "identifier normalised from TA_ac621fe07583",
        "parent refined to TileInstallation" ;
    tile:researchOrigin "TaxoAdapt" ;
    tile:validationStatus "provisional" .

tile:appliesToWBS a owl:ObjectProperty ;
    rdfs:label "관련 작업"@ko ;
    rdfs:comment "비용대상이 관련된 WBS 작업 활동."@ko ;
    rdfs:domain tile:CostItem ;
    rdfs:range tile:WorkTask ;
    tile:researchOrigin "researcher_relation_adapter" .

tile:contributesCurrentAmountTo a owl:ObjectProperty ;
    rdfs:label "금회금액 → 공종별 기성집계"@ko ;
    rdfs:comment "기성내역항목의 금회금액을 기성집계항목으로 합산"@ko ;
    rdfs:domain tile:ProgressPaymentItem ;
    rdfs:range tile:ProgressPaymentSummaryItem .

tile:documentIdentifier a owl:DatatypeProperty ;
    rdfs:label "서류 식별자"@ko ;
    rdfs:comment "업무에서 서류를 식별하는 문자열"@ko ;
    rdfs:domain tile:ProgressDocument ;
    rdfs:range xsd:string .

tile:evidenceSourceId a owl:AnnotationProperty ;
    rdfs:label "근거 출처 식별자"@ko .

tile:itemCode a owl:DatatypeProperty ;
    rdfs:label "항목 코드"@ko ;
    rdfs:comment "비용항목의 식별 코드"@ko ;
    rdfs:domain tile:CostItem ;
    rdfs:range xsd:string .

tile:itemName a owl:DatatypeProperty ;
    rdfs:label "항목명"@ko ;
    rdfs:comment "서류항목과 비용항목에서 공통으로 사용하는 품명"@ko ;
    rdfs:range xsd:string .

tile:partOfWorkTask a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "작업 구성 관계"@ko ;
    rdfs:comment "세부 작업이 상위 작업에 포함되는 관계."@ko ;
    rdfs:domain tile:WorkTask ;
    rdfs:range tile:WorkTask ;
    tile:researchOrigin "researcher_relation_adapter" .

tile:previousProgressRound a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "이전 기성회차"@ko ;
    rdfs:comment "현재 회차가 이월값을 참조하는 직전 회차"@ko ;
    rdfs:domain tile:ProgressPaymentRound ;
    rdfs:range tile:ProgressPaymentRound .

tile:providesContractAmountTo a owl:ObjectProperty ;
    rdfs:label "계약금액 → 공종별내역 계약금액"@ko ;
    rdfs:comment "계약항목의 contractAmount를 공종별내역항목의 contractAmount로 전달"@ko ;
    rdfs:domain tile:ContractItem ;
    rdfs:range tile:WorkCategoryDetailItem ;
    rdfs:subPropertyOf tile:providesContractValueTo .

tile:providesContractQuantityTo a owl:ObjectProperty ;
    rdfs:label "계약수량 → 공종별내역 계약수량"@ko ;
    rdfs:comment "계약항목의 contractQuantity를 공종별내역항목의 contractQuantity로 전달"@ko ;
    rdfs:domain tile:ContractItem ;
    rdfs:range tile:WorkCategoryDetailItem ;
    rdfs:subPropertyOf tile:providesContractValueTo .

tile:providesContractUnitPriceTo a owl:ObjectProperty ;
    rdfs:label "계약단가 → 공종별내역 계약단가"@ko ;
    rdfs:comment "계약항목의 contractUnitPrice를 공종별내역항목의 contractUnitPrice로 전달"@ko ;
    rdfs:domain tile:ContractItem ;
    rdfs:range tile:WorkCategoryDetailItem ;
    rdfs:subPropertyOf tile:providesContractValueTo .

tile:releaseCuration a owl:AnnotationProperty ;
    rdfs:label "최종본 교정 내역"@ko .

tile:researchOrigin a owl:AnnotationProperty ;
    rdfs:label "생성 출처"@ko .

tile:roundNumber a owl:DatatypeProperty ;
    rdfs:label "회차 번호"@ko ;
    rdfs:comment "기성회차의 순번"@ko ;
    rdfs:domain tile:ProgressPaymentRound ;
    rdfs:range xsd:integer .

tile:specification a owl:DatatypeProperty ;
    rdfs:label "규격"@ko ;
    rdfs:comment "공종 다음에 비용항목을 구분하는 규격 문자열"@ko ;
    rdfs:domain tile:CostItem ;
    rdfs:range xsd:string .

tile:subWorkCategoryOf a owl:ObjectProperty ;
    rdfs:label "상위 공종"@ko ;
    rdfs:comment "세부 공종이 속하는 상위 공종"@ko ;
    rdfs:domain tile:WorkCategory ;
    rdfs:range tile:WorkCategory .

tile:tileDimensionsText a owl:DatatypeProperty ;
    rdfs:label "타일 치수 표현"@ko ;
    rdfs:comment "원본 품명/규격에 명시된 타일 치수 표현. 단위나 수치의 추정 변환 없이 보존한다."@ko ;
    rdfs:domain tile:CostItem ;
    rdfs:range xsd:string ;
    tile:researchOrigin "researcher_evidence_field_adapter" .

tile:tileMaterialText a owl:DatatypeProperty ;
    rdfs:label "타일 재질 표현"@ko ;
    rdfs:comment "원본 품명/규격에 명시된 타일 재질 표현. 단위나 수치의 추정 변환 없이 보존한다."@ko ;
    rdfs:domain tile:CostItem ;
    rdfs:range xsd:string ;
    tile:researchOrigin "researcher_evidence_field_adapter" .

tile:tileMethodText a owl:DatatypeProperty ;
    rdfs:label "타일 시공방법 표현"@ko ;
    rdfs:comment "원본 품명에 명시된 시공방법 토큰"@ko ;
    rdfs:domain tile:CostItem ;
    rdfs:range xsd:string ;
    tile:researchOrigin "researcher_evidence_field_adapter" .

tile:tileSurfaceText a owl:DatatypeProperty ;
    rdfs:label "타일 적용부위 표현"@ko ;
    rdfs:comment "원본 품명/규격에 명시된 타일 적용부위 표현. 단위나 수치의 추정 변환 없이 보존한다."@ko ;
    rdfs:domain tile:CostItem ;
    rdfs:range xsd:string ;
    tile:researchOrigin "researcher_evidence_field_adapter" .

tile:tileThicknessText a owl:DatatypeProperty ;
    rdfs:label "타일 두께 표현"@ko ;
    rdfs:comment "원본 품명/규격에 명시된 타일 두께 표현. 단위나 수치의 추정 변환 없이 보존한다."@ko ;
    rdfs:domain tile:CostItem ;
    rdfs:range xsd:string ;
    tile:researchOrigin "researcher_evidence_field_adapter" .

tile:validationStatus a owl:AnnotationProperty ;
    rdfs:label "검증 상태"@ko .

tile:ApplicationSurface a owl:Class ;
    rdfs:label "타일 적용 표면"@ko ;
    rdfs:comment "타일이 적용되는 표면의 유형."@ko ;
    tile:researchOrigin "researcher_schema_adapter" .

tile:ContractStatement a owl:Class ;
    rdfs:label "계약내역서"@ko ;
    rdfs:comment "확정된 계약수량·계약단가·계약금액을 제공하는 근거서류"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom tile:ContractItem ;
            owl:onProperty tile:containsItem ],
        tile:EvidenceDocument .

tile:CostCalculationStatement a owl:Class ;
    rdfs:label "원가계산서"@ko ;
    rdfs:comment "비용항목의 원가 구성과 산정금액을 제공하는 근거서류"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom tile:CostCalculationItem ;
            owl:onProperty tile:containsItem ],
        tile:EvidenceDocument .

tile:InstallationMethod a owl:Class ;
    rdfs:label "타일 시공 방법"@ko ;
    rdfs:comment "타일을 시공하는 방법의 유형."@ko ;
    tile:researchOrigin "researcher_schema_adapter" .

tile:ProgressPaymentStatement a owl:Class ;
    rdfs:label "공사기성부분내역서"@ko ;
    rdfs:comment "회차별 기성수량과 기성금액을 산정해 제시하는 유일한 산출서류"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( tile:ProgressPaymentItem tile:ProgressPaymentSummaryItem ) ] ;
            owl:onProperty tile:containsItem ],
        [ a owl:Restriction ;
            owl:onClass tile:ProgressPaymentRound ;
            owl:onProperty tile:belongsToProgressRound ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        tile:OutputDocument .

tile:QuantityCalculationSheet a owl:Class ;
    rdfs:label "수량산출서"@ko ;
    rdfs:comment "계약수량의 산출 근거를 제공하는 근거서류"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom tile:CalculatedQuantityItem ;
            owl:onProperty tile:containsItem ],
        tile:EvidenceDocument .

tile:TileInstallation a owl:Class ;
    rdfs:label "타일 시공"@ko ;
    rdfs:comment "타일을 설치하는 작업으로, 벽, 바닥, 천장 등 다양한 표면에 타일을 붙이는 작업을 포함합니다."@ko ;
    rdfs:subClassOf tile:WorkTask ;
    tile:evidenceSourceId "WBS:3.2" ;
    tile:researchOrigin "LLM_WBS_proposal" ;
    tile:validationStatus "provisional" .

tile:TileMaterial a owl:Class ;
    rdfs:label "타일 재료"@ko ;
    rdfs:comment "타일공사에서 사용하는 재료의 유형."@ko ;
    tile:researchOrigin "researcher_schema_adapter" .

tile:WorkCategoryDetailStatement a owl:Class ;
    rdfs:label "공종별내역서"@ko ;
    rdfs:comment "공종별 비용항목의 수량·단가·금액을 제시하는 근거서류"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom tile:WorkCategoryDetailItem ;
            owl:onProperty tile:containsItem ],
        tile:EvidenceDocument .

tile:WorkCategorySummaryStatement a owl:Class ;
    rdfs:label "공종별집계표"@ko ;
    rdfs:comment "공종별 상세 비용을 합산해 제시하는 근거서류"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom tile:ContractSummaryItem ;
            owl:onProperty tile:containsItem ],
        tile:EvidenceDocument .

tile:belongsToProgressRound a owl:ObjectProperty ;
    rdfs:label "기성회차 소속"@ko ;
    rdfs:comment "공사기성부분내역서가 적용되는 기성회차"@ko ;
    rdfs:domain tile:ProgressPaymentStatement ;
    rdfs:range tile:ProgressPaymentRound .

tile:calculatedQuantity a owl:DatatypeProperty ;
    rdfs:label "산출수량"@ko ;
    rdfs:comment "수량산출서에서 계산된 계약수량 근거값"@ko ;
    rdfs:range xsd:decimal .

tile:calculatedUnitPrice a owl:DatatypeProperty ;
    rdfs:label "산출단가"@ko ;
    rdfs:comment "단위당 재료비·노무비·경비 합계로 산출된 단가"@ko ;
    rdfs:domain tile:CostCalculationItem ;
    rdfs:range xsd:decimal .

tile:contributesContractAmountTo a owl:ObjectProperty ;
    rdfs:label "계약금액 → 공종별 계약집계"@ko ;
    rdfs:comment "공종별내역항목의 계약금액을 계약집계항목으로 합산"@ko ;
    rdfs:domain tile:WorkCategoryDetailItem ;
    rdfs:range tile:ContractSummaryItem .

tile:cumulativeAmount a owl:DatatypeProperty ;
    rdfs:label "누계금액"@ko ;
    rdfs:comment "전회누계금액과 금회금액의 합"@ko ;
    rdfs:range xsd:decimal .

tile:cumulativeQuantity a owl:DatatypeProperty ;
    rdfs:label "누계수량"@ko ;
    rdfs:comment "전회누계수량과 금회수량의 합"@ko ;
    rdfs:range xsd:decimal .

tile:currentQuantity a owl:DatatypeProperty ;
    rdfs:label "금회수량"@ko ;
    rdfs:comment "기성내역 한 행에서 현재 회차에 인정된 수량"@ko ;
    rdfs:domain tile:ProgressPaymentItem ;
    rdfs:range xsd:decimal .

tile:expenseUnitCost a owl:DatatypeProperty ;
    rdfs:label "단위당 경비"@ko ;
    rdfs:comment "비용항목 한 단위당 경비"@ko ;
    rdfs:domain tile:CostCalculationItem ;
    rdfs:range xsd:decimal .

tile:laborUnitCost a owl:DatatypeProperty ;
    rdfs:label "단위당 노무비"@ko ;
    rdfs:comment "비용항목 한 단위당 노무비"@ko ;
    rdfs:domain tile:CostCalculationItem ;
    rdfs:range xsd:decimal .

tile:materialUnitCost a owl:DatatypeProperty ;
    rdfs:label "단위당 재료비"@ko ;
    rdfs:comment "비용항목 한 단위당 재료비"@ko ;
    rdfs:domain tile:CostCalculationItem ;
    rdfs:range xsd:decimal .

tile:previousCumulativeAmount a owl:DatatypeProperty ;
    rdfs:label "전회누계금액"@ko ;
    rdfs:comment "직전 회차까지 인정된 누계금액"@ko ;
    rdfs:range xsd:decimal .

tile:previousCumulativeQuantity a owl:DatatypeProperty ;
    rdfs:label "전회누계수량"@ko ;
    rdfs:comment "직전 회차까지 인정된 누계수량"@ko ;
    rdfs:range xsd:decimal .

tile:providesCalculatedQuantityTo a owl:ObjectProperty ;
    rdfs:label "산출수량 → 계약수량"@ko ;
    rdfs:comment "수량산출항목의 calculatedQuantity를 계약항목의 contractQuantity 근거로 전달"@ko ;
    rdfs:domain tile:CalculatedQuantityItem ;
    rdfs:range tile:ContractItem .

tile:providesContractAmountToProgressPaymentItem a owl:ObjectProperty ;
    rdfs:label "계약금액 → 기성내역 계약금액"@ko ;
    rdfs:comment "계약항목의 contractAmount를 기성내역항목의 contractAmount로 전달"@ko ;
    rdfs:domain tile:ContractItem ;
    rdfs:range tile:ProgressPaymentItem .

tile:providesContractQuantityToProgressPaymentItem a owl:ObjectProperty ;
    rdfs:label "계약수량 → 기성내역 계약수량"@ko ;
    rdfs:comment "계약항목의 contractQuantity를 기성내역항목의 contractQuantity로 전달"@ko ;
    rdfs:domain tile:ContractItem ;
    rdfs:range tile:ProgressPaymentItem .

tile:providesContractUnitPriceToProgressPaymentItem a owl:ObjectProperty ;
    rdfs:label "계약단가 → 기성내역 계약단가"@ko ;
    rdfs:comment "계약항목의 contractUnitPrice를 기성내역항목의 contractUnitPrice로 전달"@ko ;
    rdfs:domain tile:ContractItem ;
    rdfs:range tile:ProgressPaymentItem .

tile:providesCumulativeValuesTo a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "이전 누계 → 현재 전회값"@ko ;
    rdfs:comment "이전 기성내역항목의 누계수량·누계금액을 현재 기성내역항목의 전회누계값으로 전달"@ko ;
    rdfs:domain tile:ProgressPaymentItem ;
    rdfs:range tile:ProgressPaymentItem .

tile:remainingAmount a owl:DatatypeProperty ;
    rdfs:label "잔여금액"@ko ;
    rdfs:comment "계약금액에서 누계금액을 뺀 값"@ko ;
    rdfs:range xsd:decimal .

tile:remainingQuantity a owl:DatatypeProperty ;
    rdfs:label "잔여수량"@ko ;
    rdfs:comment "계약수량에서 누계수량을 뺀 값"@ko ;
    rdfs:range xsd:decimal .

tile:representsCostItem a owl:ObjectProperty ;
    rdfs:label "비용항목 표현"@ko ;
    rdfs:comment "서류항목이 의미하는 표준 비용항목"@ko ;
    rdfs:domain tile:DocumentItem ;
    rdfs:range tile:CostItem .

tile:usesUnit a owl:ObjectProperty ;
    rdfs:label "단위 사용"@ko ;
    rdfs:comment "비용 수량에 적용되는 측정 단위"@ko ;
    rdfs:domain tile:DetailItem ;
    rdfs:range tile:Unit .

tile:ContractSummaryItem a owl:Class ;
    rdfs:label "계약집계항목"@ko ;
    rdfs:comment "공종별내역항목의 계약금액을 공종별로 합산한 공종별집계표 항목"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf tile:contributesContractAmountTo ] ;
            owl:someValuesFrom tile:WorkCategoryDetailItem ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:contractAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        tile:SummaryItem .

tile:OutputDocument a owl:Class ;
    rdfs:label "산출서류"@ko ;
    rdfs:comment "근거서류의 정보를 사용해 기성금액 산정 결과를 제시하는 서류"@ko ;
    rdfs:subClassOf tile:ProgressDocument .

tile:ProgressPaymentSummaryItem a owl:Class ;
    rdfs:label "기성집계항목"@ko ;
    rdfs:comment "기성금액항목의 금회금액을 공종별로 합산한 공사기성부분내역서 항목"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:currentAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        tile:SummaryItem .

tile:SummaryItem a owl:Class ;
    rdfs:label "집계항목"@ko ;
    rdfs:comment "계약 또는 기성 상세항목의 금액을 동일 공종별로 합산한 항목"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass tile:WorkCategory ;
            owl:onProperty tile:belongsToWorkCategory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        tile:DocumentItem .

tile:Unit a owl:Class ;
    rdfs:label "단위"@ko ;
    rdfs:comment "비용항목 수량을 측정하는 단위"@ko .

tile:belongsToWorkCategory a owl:ObjectProperty ;
    rdfs:label "공종 소속"@ko ;
    rdfs:comment "비용항목 또는 집계항목을 철근·콘크리트·거푸집·동바리 중 하나로 분류"@ko ;
    rdfs:range tile:WorkCategory .

tile:currentAmount a owl:DatatypeProperty ;
    rdfs:label "금회금액"@ko ;
    rdfs:comment "현재 기성회차에서 인정되며 누계기성금액 산정에 반영되는 금액"@ko ;
    rdfs:range xsd:decimal .

tile:CalculatedQuantityItem a owl:Class ;
    rdfs:label "수량산출항목"@ko ;
    rdfs:comment "수량산출서에서 계약수량의 근거가 되는 산출수량 항목"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:calculatedQuantity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        tile:DetailItem .

tile:contractQuantity a owl:DatatypeProperty ;
    rdfs:label "계약수량"@ko ;
    rdfs:comment "계약내역서에 확정된 수량"@ko ;
    rdfs:range xsd:decimal .

tile:contractUnitPrice a owl:DatatypeProperty ;
    rdfs:label "계약단가"@ko ;
    rdfs:comment "계약내역서에 확정된 단가"@ko ;
    rdfs:range xsd:decimal .

tile:TileInstallationCostItem a owl:Class ;
    rdfs:label "타일 설치 비용대상"@ko ;
    rdfs:comment "타일 설치 작업의 비용대상."@ko ;
    rdfs:subClassOf tile:CostItem ;
    tile:researchOrigin "researcher_schema_adapter" .

tile:TileMaterialCostItem a owl:Class ;
    rdfs:label "타일 자재 비용대상"@ko ;
    rdfs:comment "타일 자재 공급의 비용대상."@ko ;
    rdfs:subClassOf tile:CostItem ;
    tile:researchOrigin "researcher_schema_adapter" .

tile:contractAmount a owl:DatatypeProperty ;
    rdfs:label "계약금액"@ko ;
    rdfs:comment "계약내역서에 확정된 금액"@ko ;
    rdfs:range xsd:decimal .

tile:providesContractValueTo a owl:ObjectProperty ;
    rdfs:label "계약값 전달"@ko ;
    rdfs:comment "계약항목의 수량·단가·금액을 공종별내역항목으로 전달"@ko ;
    rdfs:domain tile:ContractItem ;
    rdfs:range tile:WorkCategoryDetailItem .

tile:CostCalculationItem a owl:Class ;
    rdfs:label "원가계산항목"@ko ;
    rdfs:comment "원가계산서에서 비용 산정 근거를 제공하는 항목"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:materialUnitCost ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:calculatedUnitPrice ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:laborUnitCost ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:expenseUnitCost ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        tile:DetailItem .

tile:DocumentItem a owl:Class ;
    rdfs:label "기성서류항목"@ko ;
    rdfs:comment "기성서류에 포함되는 비용정보의 의미 단위"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass tile:ProgressDocument ;
            owl:onProperty [ owl:inverseOf tile:containsItem ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

tile:ProgressDocument a owl:Class ;
    rdfs:label "기성서류"@ko ;
    rdfs:comment "철근콘크리트 기성금액 산정에 직접 사용하는 서류의 최상위 클래스"@ko ;
    owl:disjointUnionOf ( tile:EvidenceDocument tile:OutputDocument ) .

tile:ProgressPaymentRound a owl:Class ;
    rdfs:label "기성회차"@ko ;
    rdfs:comment "기성 산정과 청구의 시간 단위"@ko .

tile:WorkCategory a owl:Class ;
    rdfs:label "공종"@ko ;
    rdfs:comment "철근콘크리트공사와 그 하위 네 공종을 표현하는 통제 분류"@ko .

tile:DetailItem a owl:Class ;
    rdfs:label "상세비용항목"@ko ;
    rdfs:comment "집계 전 개별 비용항목"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass tile:CostItem ;
            owl:onProperty tile:representsCostItem ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass tile:Unit ;
            owl:onProperty tile:usesUnit ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        tile:DocumentItem .

tile:EvidenceDocument a owl:Class ;
    rdfs:label "근거서류"@ko ;
    rdfs:comment "기성금액 산정에 필요한 수량·단가·금액의 근거를 제공하는 서류"@ko ;
    rdfs:subClassOf tile:ProgressDocument ;
    owl:disjointUnionOf ( tile:ContractStatement tile:CostCalculationStatement tile:QuantityCalculationSheet tile:WorkCategoryDetailStatement tile:WorkCategorySummaryStatement ) .

tile:WorkTask a owl:Class ;
    rdfs:label "타일 작업 활동"@ko ;
    rdfs:comment "타일공사의 작업 활동 유형."@ko ;
    tile:researchOrigin "researcher_schema_adapter" .

tile:WorkCategoryDetailItem a owl:Class ;
    rdfs:label "공종별내역항목"@ko ;
    rdfs:comment "공종별내역서에 수량·단가·금액을 나타내는 항목"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass tile:ContractItem ;
            owl:onProperty [ owl:inverseOf tile:providesContractValueTo ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:contractQuantity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:contractUnitPrice ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:contractAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        tile:DetailItem .

tile:containsItem a owl:ObjectProperty ;
    rdfs:label "항목 포함"@ko ;
    rdfs:comment "기성서류가 포함하는 비용정보 항목"@ko ;
    rdfs:domain tile:ProgressDocument ;
    rdfs:range tile:DocumentItem .

tile:ProgressPaymentItem a owl:Class ;
    rdfs:label "기성내역항목"@ko ;
    rdfs:comment "공사기성부분내역서에서 전회·금회·누계·잔여 수량과 금액을 산정하는 항목"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass tile:ContractItem ;
            owl:onProperty [ owl:inverseOf tile:providesContractUnitPriceToProgressPaymentItem ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass tile:ProgressPaymentItem ;
            owl:onProperty [ owl:inverseOf tile:providesCumulativeValuesTo ] ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:currentAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:currentQuantity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:contractQuantity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:cumulativeQuantity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:remainingAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:contractUnitPrice ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:contractAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass tile:ContractItem ;
            owl:onProperty [ owl:inverseOf tile:providesContractQuantityToProgressPaymentItem ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:cumulativeAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:previousCumulativeQuantity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:remainingQuantity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass tile:ContractItem ;
            owl:onProperty [ owl:inverseOf tile:providesContractAmountToProgressPaymentItem ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:previousCumulativeAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        tile:DetailItem .

tile:CostItem a owl:Class ;
    rdfs:label "비용항목"@ko ;
    rdfs:comment "서류별 항목이 공통으로 나타내는 표준 비용 대상"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass tile:WorkCategory ;
            owl:onProperty tile:belongsToWorkCategory ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    owl:disjointWith tile:ApplicationSurface,
        tile:DocumentItem,
        tile:InstallationMethod,
        tile:TileMaterial,
        tile:WorkTask .

tile:ContractItem a owl:Class ;
    rdfs:label "계약항목"@ko ;
    rdfs:comment "계약수량·계약단가·계약금액을 제공하는 계약내역서 항목"@ko ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:contractQuantity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:contractUnitPrice ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:decimal ;
            owl:onProperty tile:contractAmount ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf tile:providesCalculatedQuantityTo ] ;
            owl:someValuesFrom tile:CalculatedQuantityItem ],
        tile:DetailItem .
