@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tbox: <https://example.org/kicem/architecture/tile#> .

<https://example.org/kicem/architecture/tile> a owl:Ontology ;
    owl:versionInfo "3.1.0" .

tbox:AdhesiveFloorTileInstallation a owl:Class ;
    rdfs:label "바닥타일 접착 붙이기"@ko ;
    rdfs:comment "접착제로 바닥타일을 붙이는 작업."@ko ;
    rdfs:subClassOf tbox:FloorTileInstallation ;
    tbox:evidenceSection "3.3.4" ;
    tbox:evidenceSourceId "KCS-41-48-01" ;
    tbox:predictedDirectParent tbox:FloorTileInstallation ;
    tbox:predictionMethod "lexical-taxonomic-v1:identifier-suffix" ;
    tbox:validationStatus "candidate" .

tbox:AdhesiveWallTileInstallation a owl:Class ;
