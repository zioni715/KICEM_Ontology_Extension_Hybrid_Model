@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tbox: <https://example.org/kicem/hybrid/civil_stormwater#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kicem/hybrid/civil_stormwater> a owl:Ontology ;
    owl:versionInfo "Provisional hybrid T-Box; no independent expert gold validation" .

tbox:ApplicationSurface a owl:Class ;
    rdfs:label "ApplicationSurface" ;
    rdfs:comment "우수 적용 표면" ;
    tbox:origin "researcher_anchor" .

tbox:CalculatedQuantityItem a owl:Class ;
    rdfs:label "수량산출항목" ;
    rdfs:comment "수량산출서에서 계약수량의 근거가 되는 산출수량 항목" ;
    rdfs:subClassOf tbox:DetailItem ;
    tbox:origin "seed" .

tbox:CatchBasinInstallationCostItem a owl:Class ;
    rdfs:label "우수받이 설치 비용" ;
    rdfs:comment "우수받이를 계획 위치와 높이에 설치하는 작업에 대한 비용 항목." ;
    rdfs:subClassOf tbox:StormwaterInstallationCostItem ;
    tbox:evidence "[{\"source_id\": \"STD:004\", \"quote\": \"우수받이 설치 우수받이를 계획 위치와 높이에 설치하는 작업.\"}]" ;
    tbox:origin "LLM_document_proposal" .

tbox:ContractItem a owl:Class ;
    rdfs:label "계약항목" ;
    rdfs:comment "계약수량·계약단가·계약금액을 제공하는 계약내역서 항목" ;
    rdfs:subClassOf tbox:DetailItem ;
    tbox:origin "seed" .

tbox:ContractStatement a owl:Class ;
    rdfs:label "계약내역서" ;
    rdfs:comment "확정된 계약수량·계약단가·계약금액을 제공하는 근거서류" ;
    rdfs:subClassOf tbox:EvidenceDocument ;
    tbox:origin "seed" .

tbox:ContractSummaryItem a owl:Class ;
    rdfs:label "계약집계항목" ;
    rdfs:comment "공종별내역항목의 계약금액을 공종별로 합산한 공종별집계표 항목" ;
    rdfs:subClassOf tbox:SummaryItem ;
    tbox:origin "seed" .

tbox:CostCalculationItem a owl:Class ;
    rdfs:label "원가계산항목" ;
    rdfs:comment "원가계산서에서 비용 산정 근거를 제공하는 항목" ;
    rdfs:subClassOf tbox:DetailItem ;
    tbox:origin "seed" .

tbox:CostCalculationStatement a owl:Class ;
    rdfs:label "원가계산서" ;
    rdfs:comment "비용항목의 원가 구성과 산정금액을 제공하는 근거서류" ;
    rdfs:subClassOf tbox:EvidenceDocument ;
    tbox:origin "seed" .

tbox:DrainageGutterInstallationCostItem a owl:Class ;
    rdfs:label "배수 측구 설치 비용" ;
    rdfs:comment "배수 측구를 설계 선형과 경사에 따라 시공하는 작업에 대한 비용 항목." ;
    rdfs:subClassOf tbox:StormwaterInstallationCostItem ;
    tbox:evidence "[{\"source_id\": \"STD:003\", \"quote\": \"배수 측구 시공 설계 선형과 경사에 따라 측구를 시공하는 작업.\"}]" ;
    tbox:origin "LLM_document_proposal" .

tbox:DrainagePipeInstallationCostItem a owl:Class ;
    rdfs:label "우수 배수관 설치 비용" ;
    rdfs:comment "계획 경사를 유지하여 우수 배수관을 설치하는 작업에 대한 비용 항목." ;
    rdfs:subClassOf tbox:StormwaterInstallationCostItem ;
    tbox:evidence "[{\"source_id\": \"STD:006\", \"quote\": \"우수 배수관 설치 계획 경사를 유지하여 우수 배수관을 설치하는 작업.\"}]" ;
    tbox:origin "LLM_document_proposal" .

tbox:InstallationMethod a owl:Class ;
    rdfs:label "InstallationMethod" ;
    rdfs:comment "우수 시공 방법" ;
    tbox:origin "researcher_anchor" .

tbox:ProgressPaymentItem a owl:Class ;
    rdfs:label "기성내역항목" ;
    rdfs:comment "공사기성부분내역서에서 전회·금회·누계·잔여 수량과 금액을 산정하는 항목" ;
    rdfs:subClassOf tbox:DetailItem ;
    tbox:origin "seed" .

tbox:ProgressPaymentRound a owl:Class ;
    rdfs:label "기성회차" ;
    rdfs:comment "기성 산정과 청구의 시간 단위" ;
    tbox:origin "seed" .

tbox:ProgressPaymentStatement a owl:Class ;
    rdfs:label "공사기성부분내역서" ;
    rdfs:comment "회차별 기성수량과 기성금액을 산정해 제시하는 유일한 산출서류" ;
    rdfs:subClassOf tbox:OutputDocument ;
    tbox:origin "seed" .

tbox:ProgressPaymentSummaryItem a owl:Class ;
    rdfs:label "기성집계항목" ;
    rdfs:comment "기성금액항목의 금회금액을 공종별로 합산한 공사기성부분내역서 항목" ;
    rdfs:subClassOf tbox:SummaryItem ;
    tbox:origin "seed" .

tbox:QuantityCalculationSheet a owl:Class ;
    rdfs:label "수량산출서" ;
    rdfs:comment "계약수량의 산출 근거를 제공하는 근거서류" ;
    rdfs:subClassOf tbox:EvidenceDocument ;
    tbox:origin "seed" .

tbox:StormwaterMaterial a owl:Class ;
    rdfs:label "StormwaterMaterial" ;
    rdfs:comment "우수 재료 유형" ;
    tbox:origin "researcher_anchor" .

tbox:StormwaterMaterialCostItem a owl:Class ;
    rdfs:label "우수 자재 비용항목" ;
    rdfs:comment "우수 자재의 공급·구매에 대한 비용대상. 자재 자체나 설치 작업 비용은 아니다." ;
    rdfs:subClassOf tbox:CostItem ;
    tbox:origin "researcher_cost_role_bridge" .

tbox:SumpPitInstallationCostItem a owl:Class ;
    rdfs:label "집수정 설치 비용" ;
    rdfs:comment "집수정을 계획 위치와 높이에 설치하는 작업에 대한 비용 항목." ;
    rdfs:subClassOf tbox:StormwaterInstallationCostItem ;
    tbox:evidence "[{\"source_id\": \"STD:005\", \"quote\": \"집수정 설치 집수정을 계획 위치와 높이에 설치하는 작업.\"}]" ;
    tbox:origin "LLM_document_proposal" .

tbox:TA_1dc814da5101 a owl:Class ;
    rdfs:label "stormwater_installation" ;
    rdfs:comment "우수 처리를 위한 배수 시설 설치 작업을 포함합니다." ;
    rdfs:subClassOf tbox:DrainageConstruction ;
    tbox:evidence "[{\"source_id\": \"WBS:W004\", \"quote\": \"우수받이 설치: 우수받이를 계획 위치와 높이에 설치하는 작업. [KCS-11-40-25 § 3.1.3]\"}, {\"source_id\": \"WBS:W005\", \"quote\": \"집수정 설치: 집수정을 계획 위치와 높이에 설치하는 작업. [KCS-11-40-25 § 3.1.3]\"}, {\"source_id\": \"WBS:W006\", \"quote\": \"우수 배수관 설치: 계획 경사를 유지하여 우수 배수관을 설치하는 작업. [KCS-11-40-15 § 3.1(2)-(4), 3.2.5]\"}]" ;
    tbox:origin "TaxoAdapt" .

tbox:Unit a owl:Class ;
    rdfs:label "단위" ;
    rdfs:comment "비용항목 수량을 측정하는 단위" ;
    tbox:origin "seed" .

tbox:WorkCategory a owl:Class ;
    rdfs:label "공종" ;
    rdfs:comment "철근콘크리트공사와 그 하위 네 공종을 표현하는 통제 분류" ;
    tbox:origin "seed" .

tbox:WorkCategoryDetailItem a owl:Class ;
    rdfs:label "공종별내역항목" ;
    rdfs:comment "공종별내역서에 수량·단가·금액을 나타내는 항목" ;
    rdfs:subClassOf tbox:DetailItem ;
    tbox:origin "seed" .

tbox:WorkCategoryDetailStatement a owl:Class ;
    rdfs:label "공종별내역서" ;
    rdfs:comment "공종별 비용항목의 수량·단가·금액을 제시하는 근거서류" ;
    rdfs:subClassOf tbox:EvidenceDocument ;
    tbox:origin "seed" .

tbox:WorkCategorySummaryStatement a owl:Class ;
    rdfs:label "공종별집계표" ;
    rdfs:comment "공종별 상세 비용을 합산해 제시하는 근거서류" ;
    rdfs:subClassOf tbox:EvidenceDocument ;
    tbox:origin "seed" .

tbox:evidence a owl:AnnotationProperty .

tbox:origin a owl:AnnotationProperty .

tbox:stormwaterMaterialText a owl:DatatypeProperty ;
    rdfs:label "우수 재질 표현" ;
    rdfs:comment "원본 품명/규격에 명시된 우수 재질 표현. 단위나 수치의 추정 변환 없이 보존한다." ;
    rdfs:domain tbox:CostItem ;
    rdfs:range xsd:string .

tbox:stormwaterMethodText a owl:DatatypeProperty ;
    rdfs:label "우수 시공방법 표현" ;
    rdfs:comment "원본 품명/규격에 명시된 우수 시공방법 표현. 단위나 수치의 추정 변환 없이 보존한다." ;
    rdfs:domain tbox:CostItem ;
    rdfs:range xsd:string .

tbox:DrainageConstruction a owl:Class ;
    rdfs:label "배수공사" ;
    rdfs:comment "우수를 집수하고 배제하기 위한 모든 시공 작업." ;
    rdfs:subClassOf tbox:WorkTask ;
    tbox:evidence "[{\"source_id\": \"WBS:W004\", \"quote\": \"우수받이 설치: 우수받이를 계획 위치와 높이에 설치하는 작업. [KCS-11-40-25 § 3.1.3]\"}, {\"source_id\": \"WBS:W005\", \"quote\": \"집수정 설치: 집수정을 계획 위치와 높이에 설치하는 작업. [KCS-11-40-25 § 3.1.3]\"}, {\"source_id\": \"WBS:W006\", \"quote\": \"우수 배수관 설치: 계획 경사를 유지하여 우수 배수관을 설치하는 작업. [KCS-11-40-15 § 3.1(2)-(4), 3.2.5]\"}, {\"source_id\": \"WBS:W007\", \"quote\": \"우수 맨홀 설치: 우수관로 점검을 위한 맨홀과 뚜껑을 설치하는 작업. [KCS-11-40-25 § 2.5, 3.1.5]\"}, {\"source_id\": \"WBS:W008\", \"quote\": \"스틸그레이팅 설치: 우수받이 또는 집수정에 스틸그레이팅을 설치하는 작업. [KCS-11-40-25 § 3.1.3(3)③]\"}]" ;
    tbox:origin "LLM_WBS_proposal" .

tbox:OutputDocument a owl:Class ;
    rdfs:label "산출서류" ;
    rdfs:comment "근거서류의 정보를 사용해 기성금액 산정 결과를 제시하는 서류" ;
    rdfs:subClassOf tbox:ProgressDocument ;
    tbox:origin "seed" .

tbox:WorkTask a owl:Class ;
    rdfs:label "WorkTask" ;
    rdfs:comment "우수 시공 작업 활동" ;
    tbox:origin "researcher_anchor" .

tbox:DocumentItem a owl:Class ;
    rdfs:label "기성서류항목" ;
    rdfs:comment "기성서류에 포함되는 비용정보의 의미 단위" ;
    tbox:origin "seed" .

tbox:ProgressDocument a owl:Class ;
    rdfs:label "기성서류" ;
    rdfs:comment "철근콘크리트 기성금액 산정에 직접 사용하는 서류의 최상위 클래스" ;
    tbox:origin "seed" .

tbox:SummaryItem a owl:Class ;
    rdfs:label "집계항목" ;
    rdfs:comment "계약 또는 기성 상세항목의 금액을 동일 공종별로 합산한 항목" ;
    rdfs:subClassOf tbox:DocumentItem ;
    tbox:origin "seed" .

tbox:CostItem a owl:Class ;
    rdfs:label "비용항목" ;
    rdfs:comment "서류별 항목이 공통으로 나타내는 표준 비용 대상" ;
    tbox:origin "seed" .

tbox:StormwaterInstallationCostItem a owl:Class ;
    rdfs:label "우수 설치 비용항목" ;
    rdfs:comment "우수 설치 시공 작업에 대한 비용대상. 작업 활동 자체나 자재 공급 비용은 아니다." ;
    rdfs:subClassOf tbox:CostItem ;
    tbox:origin "researcher_cost_role_bridge" .

tbox:DetailItem a owl:Class ;
    rdfs:label "상세비용항목" ;
    rdfs:comment "집계 전 개별 비용항목" ;
    rdfs:subClassOf tbox:DocumentItem ;
    tbox:origin "seed" .

tbox:EvidenceDocument a owl:Class ;
    rdfs:label "근거서류" ;
    rdfs:comment "기성금액 산정에 필요한 수량·단가·금액의 근거를 제공하는 서류" ;
    rdfs:subClassOf tbox:ProgressDocument ;
    tbox:origin "seed" .

