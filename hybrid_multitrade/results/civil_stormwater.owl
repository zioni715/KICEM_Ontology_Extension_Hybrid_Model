  <rdf:Description rdf:about="https://example.org/kicem/hybrid/civil_stormwater#DrainageGutterInstallationCostItem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>배수 측구 설치 비용</rdfs:label>
    <rdfs:comment>배수 측구를 설계 선형과 경사에 따라 시공하는 작업에 대한 비용 항목.</rdfs:comment>
    <tbox:origin>LLM_document_proposal</tbox:origin>
    <rdfs:subClassOf rdf:resource="https://example.org/kicem/hybrid/civil_stormwater#StormwaterInstallationCostItem"/>
    <tbox:evidence>[{"source_id": "STD:003", "quote": "배수 측구 시공 설계 선형과 경사에 따라 측구를 시공하는 작업."}]</tbox:evidence>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/kicem/hybrid/civil_stormwater#DocumentItem">
