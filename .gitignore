# Credentials: example/backup files are also private by default.
.env
.env.*
*.env
*.env.*
.envrc
/secrets/
**/secrets/
credentials*.json
credentials*.yaml
credentials*.yml
*service-account*.json
*service_account*.json
auth.json
token.json
tokens.json
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*

# Private research inputs; keep the OWL2 baseline available for version control.
/Datasets/
/KO/*
!/KO/OWL2/
/Papers/
/KCS*.md
/WBS*
/CBS*
/wbs*
/cbs*

# Experiments contain source excerpts, prices, prompts, caches, and reports.
# Exclude the complete folders, including their execution code.
/test/
/test[0-9]*/
/TEST/
/TEST[0-9]*/

# Local reference clones; keep original repositories untouched.
/TaxoPro/
/MILA/
/taxoadapt/

